-- When a chapter's reading last changed, for Dōchō Sync (chapter_progress.sq). Chapters read before
-- this have no time: Dōchō Sync keeps the furthest point for those.
CREATE TABLE chapter_progress(
    chapter_id INTEGER NOT NULL PRIMARY KEY,
    at INTEGER NOT NULL,
    FOREIGN KEY(chapter_id) REFERENCES chapter (id)
    ON DELETE CASCADE
);

CREATE TRIGGER chapter_progress_changed
AFTER UPDATE OF user_read, user_bookmark, user_last_page_read ON chapter
WHEN new.user_read IS NOT old.user_read
    OR new.user_bookmark IS NOT old.user_bookmark
    OR new.user_last_page_read IS NOT old.user_last_page_read
BEGIN
    INSERT OR REPLACE INTO chapter_progress(chapter_id, at)
    VALUES (new.id, CAST(round((julianday('now') - 2440587.5) * 86400000) AS INTEGER));
END;
